{
  "Cors": {
    "Origins": [
      "http://localhost:3002"
    ]
  },
  "Storage": {
    "Root": "uploads",
    "MaxBytes": 0
  },
  "Database": {
    "AutoMigrate": false
  },
  "Ocr": {
    "Provider": "AUTO",
    "TimeoutSeconds": 0,
    "MaxConcurrentJobs": 2,
    "MaxQueuedJobs": 32,
    "QueueWaitSeconds": 600
  },
  "Seed": {
    "DemoData": false
  },
  "OpenRouter": {
    "Model": "openrouter/free",
    "ConcurrentPages": 2,
    "PageTimeoutSeconds": 0,
    "DocumentTimeoutSeconds": 0
  },
  "Hybrid": {
    "TimeoutSeconds": 0,
    "PaddleTimeoutSeconds": 0,
    "MaxAiPages": 0,
    "AutoPaddleProvider": "LOCAL"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;backend"
}
