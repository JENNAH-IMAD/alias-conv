# Copy to .env and supply your own random secrets. No default password.
# Used only when running the API container against PostgreSQL on the PC.
LOCAL_DATABASE_CONNECTION=Host=host.docker.internal;Port=5432;Database=convertbank;Username=postgres;Password=CHANGE_ME
DEMO_DATA=false
FRONTEND_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_URL=/api
FRONTEND_BIND_ADDRESS=0.0.0.0
OCR_CONCURRENT_JOBS=2
OCR_QUEUED_JOBS=32
OCR_WORKERS=2
OCR_CPU_THREADS=2
OCR_MODEL_SIZE=small
OCR_DETECTION_MAX_SIDE=1280
ALLOWED_HOSTS=localhost;127.0.0.1;backend
# Local API defaults to this OCR URL; Docker uses http://ocr:8091.
Ocr__Provider=AUTO
Ocr__CloudModel=PP-OCRv6
Ocr__CloudToken=
Ocr__BaseUrl=http://127.0.0.1:8091
# 0 = aucune duree maximale de conversion ; l'annulation utilisateur reste active.
Ocr__TimeoutSeconds=0

# OpenRouter : modeles gratuits et parseur PDF gratuit, puis export selon le modele choisi.
# Choisir Ocr__Provider=OPENROUTER pour activer ce moteur.
OpenRouter__Model=openrouter/free
OpenRouter__ApiKey=
OpenRouter__ConcurrentPages=2
OpenRouter__PageTimeoutSeconds=0
OpenRouter__DocumentTimeoutSeconds=0
Hybrid__AutoPaddleProvider=LOCAL
Hybrid__TimeoutSeconds=0
Hybrid__PaddleTimeoutSeconds=0
# 0 = toutes les pages non resolues peuvent passer en assistance gratuite.
Hybrid__MaxAiPages=0
