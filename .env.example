# Copy to .env and supply your own random secrets. No default password.
# Used only when running the API container against PostgreSQL on the PC.
LOCAL_DATABASE_CONNECTION=Host=host.docker.internal;Port=5432;Database=convertbank;Username=postgres;Password=admin
JWT_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_DATA=false
FRONTEND_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:5081/api
ALLOWED_HOSTS=localhost;127.0.0.1;backend
