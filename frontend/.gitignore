# Fichiers locaux et résultats générés, exclus du dépôt.

# Dépendances
/node_modules
/public/pdfjs/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Résultats des tests
/coverage
/test-results/
/test-results-*/
/playwright-report/

# Compilation Next.js
/.next/
/out/

# Compilation de production
/build

# Fichiers propres au poste
.DS_Store
*.pem

# Journaux de diagnostic
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Configuration locale ; seul le modèle sans secret est partagé.
.env*
!.env.example

# Configuration locale Vercel
.vercel

# Fichiers générés par TypeScript et Next.js
*.tsbuildinfo
next-env.d.ts
